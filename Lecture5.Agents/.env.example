# Образец настроек для домашки по лекции 5.
# Скопируйте в .env и подставьте свои значения. Файл .env в .gitignore.

# Агент под тестом
AGENT_URL=https://realestate.eval-ai.com/ask
AGENT_API_KEY=ключ-из-раздела-ИИ-тренажёры
AGENT_USER_ID=your-user-id

# Модель-судья через курсовой прокси
PROXY_BASE_URL=http://5.11.83.110:8000
PROXY_API_KEY=sk-proxy-...
JUDGE_MODEL=gpt-4o-mini

# Langfuse: трейсы и метрики онлайн-оценки (Практика 2).
# Ключи выдаются при создании проекта, иначе Settings -> API Keys.
# LANGFUSE_HOST должен совпадать с регионом ключей:
#   https://us.cloud.langfuse.com  для US
#   https://cloud.langfuse.com     для EU
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# EvaliQA: приём трейсов (Практика 2).
# Весь блок копируется кнопкой на вкладке Tracing после выбора проекта
# и генерации ключа. Ключ показывается один раз.
TRACING_ENABLED=true
TRACING_URL=https://evaliqa.com/api/traces/ingest
TRACING_PROJECT=идентификатор-проекта
TRACING_API_KEY=eva_...
