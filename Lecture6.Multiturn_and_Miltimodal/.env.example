# Образец настроек для домашки по лекции 6.
# Скопируйте в .env и подставьте свои значения. Файл .env в .gitignore.

# Агент под тестом — мультитурн-вариант агента недвижимости
AGENT_URL=...
AGENT_API_KEY=...
AGENT_USER_ID=...

# Модель-судья через курсовой прокси.
# Для мультимодальных метрик модель обязана поддерживать vision.
PROXY_BASE_URL=...
PROXY_API_KEY=...
JUDGE_MODEL=gpt-4o-mini

# Порог метрик. Фиксируется до прогона, по результатам не правится.
METRIC_THRESHOLD=0.5
